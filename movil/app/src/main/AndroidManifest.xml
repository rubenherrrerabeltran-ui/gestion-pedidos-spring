<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Único permiso: acceso a Internet para consumir la API REST (principio de mínimo privilegio). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".GestionPedidosApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GestionPedidos">

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.inicio.InicioActivity" android:exported="false" />
        <activity android:name=".ui.productos.ProductosActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.carrito.CarritoActivity" android:exported="false" />
        <activity android:name=".ui.pedidos.PedidosActivity" android:exported="false" />
        <activity android:name=".ui.pedidos.DetallePedidoActivity" android:exported="false" />
        <activity android:name=".ui.reportes.ReporteActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
