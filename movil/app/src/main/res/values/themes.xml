<resources>
    <!-- Tema Material 3 con los colores institucionales del SENA. -->
    <style name="Base.Theme.GestionPedidos" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/verde_sena</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorPrimaryContainer">@color/verde_claro</item>
        <item name="colorSecondary">@color/azul_sena</item>
        <item name="colorOnSecondary">@color/blanco</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="materialCardViewStyle">@style/Tarjeta</item>
    </style>

    <style name="Theme.GestionPedidos" parent="Base.Theme.GestionPedidos" />

    <!-- Estilos reutilizables. -->
    <style name="Tarjeta" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/blanco</item>
        <item name="cardCornerRadius">@dimen/radio_tarjeta</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="Etiqueta">
        <item name="android:textColor">@color/gris</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Valor">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Indicador">
        <item name="android:textColor">@color/azul_sena</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BotonMenu" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/margen_chico</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
