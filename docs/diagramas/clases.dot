digraph G {
  graph [rankdir=TB, fontname="Arial", fontsize=13, nodesep=0.4, ranksep=0.5, label="Diagrama de clases - módulo de reportes integrado (v1.3.0)", labelloc=t];
  node [shape=plaintext, fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9, color="#444444"];
  ctrl [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#f5f9fc" color="#00324d"><tr><td bgcolor="#00324d"><font color="white"><b>ReporteControlador</b></font></td></tr><tr><td align="left">«@Controller» /reportes</td></tr><tr><td align="left">+ ventas(desde, hasta, modelo): String<br align="left"/>+ exportar(desde, hasta): ResponseEntity&lt;byte[]&gt;</td></tr></table>>];
  apic [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#f5f9fc" color="#00324d"><tr><td bgcolor="#00324d"><font color="white"><b>ReporteApiControlador</b></font></td></tr><tr><td align="left">«@RestController» /api/reportes</td></tr><tr><td align="left">+ ventas(desde, hasta): ReporteVentas</td></tr></table>>];
  serv [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#fff8e6" color="#a15c00"><tr><td bgcolor="#a15c00"><font color="white"><b>ReporteServicio</b></font></td></tr><tr><td align="left">«@Service»<br align="left"/>- pedidoRepositorio: PedidoRepositorio<br align="left"/>- reloj: Clock</td></tr><tr><td align="left">+ generar(desde, hasta): ReporteVentas<br align="left"/>+ exportarCsv(desde, hasta): String<br align="left"/>~ textoCsv(texto): String</td></tr></table>>];
  repo [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#eef6e8" color="#39a900"><tr><td bgcolor="#39a900"><font color="white"><b>«interface» PedidoRepositorio</b></font></td></tr><tr><td align="left">+ listar(idUsuario): List&lt;Pedido&gt;<br align="left"/>+ buscarPorId(id): Optional&lt;Pedido&gt;<br align="left"/>+ insertar(pedido): Pedido<br align="left"/>+ actualizarEstado(id, estado): boolean<br align="left"/>+ contarPorEstado(): Map</td></tr></table>>];
  jdbc [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#eef6e8" color="#39a900"><tr><td><b>PedidoRepositorioJdbc</b></td></tr><tr><td align="left">«@Repository» JdbcClient</td></tr></table>>];
  fake [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#f2f2f2" color="#777777"><tr><td><b>PedidoRepositorioEnMemoria</b></td></tr><tr><td align="left">doble de prueba (src/test)</td></tr></table>>];
  rv [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#ffffff" color="#555555"><tr><td><b>«record» ReporteVentas</b></td></tr><tr><td align="left">desde, hasta: LocalDate<br align="left"/>pedidosEnPeriodo, pedidosVendidos: int<br align="left"/>subtotal, iva, total, ticketPromedio: BigDecimal<br align="left"/>pedidosPorEstado: Map&lt;EstadoPedido, Long&gt;</td></tr></table>>];
  vp [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#ffffff" color="#555555"><tr><td><b>«record» VentaProducto</b></td></tr><tr><td align="left">idProducto, nombreProducto<br align="left"/>unidades: long, total: BigDecimal</td></tr></table>>];
  vc [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#ffffff" color="#555555"><tr><td><b>«record» VentaCliente</b></td></tr><tr><td align="left">idCliente, nombreCliente<br align="left"/>pedidos: long, total: BigDecimal</td></tr></table>>];
  ped [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#ffffff" color="#555555"><tr><td><b>Pedido</b></td></tr><tr><td align="left">idPedido, idUsuario, nombreCliente<br align="left"/>fechaPedido, estado</td></tr><tr><td align="left">+ calcularSubtotal()<br align="left"/>+ calcularIva()  + calcularTotal()</td></tr></table>>];
  det [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#ffffff" color="#555555"><tr><td><b>DetallePedido</b></td></tr><tr><td align="left">idProducto, nombreProducto<br align="left"/>cantidad, precioUnitario</td></tr><tr><td align="left">+ calcularSubtotal()</td></tr></table>>];
  est [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#ffffff" color="#555555"><tr><td><b>«enum» EstadoPedido</b></td></tr><tr><td align="left">PENDIENTE, PAGADO, ENVIADO, CANCELADO</td></tr><tr><td align="left">+ puedeCambiarA(estado)</td></tr></table>>];
  ctrl -> serv [arrowhead=vee, label="usa"]; apic -> serv [arrowhead=vee, label="usa"];
  serv -> repo [arrowhead=vee, label="depende de (inyección)"]; serv -> rv [arrowhead=vee, style=dashed, label="crea"];
  jdbc -> repo [arrowhead=onormal, style=dashed, label="implementa"]; fake -> repo [arrowhead=onormal, style=dashed, label="implementa"];
  rv -> vp [arrowhead=odiamond, dir=back, label="productosMasVendidos 0..5"]; rv -> vc [arrowhead=odiamond, dir=back, label="ventasPorCliente *"];
  repo -> ped [arrowhead=vee, style=dashed]; ped -> det [arrowtail=diamond, dir=back, label="detalles 1..*"]; ped -> est [arrowhead=vee];
}
